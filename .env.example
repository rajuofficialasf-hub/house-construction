# এই ফাইলটি কপি করে `.env.local` নামে রাখুন এবং মান বসান। `.env.local` গিটে যাবে না।
# Vite-এ শুধু VITE_ প্রিফিক্সযুক্ত ভ্যারিয়েবল ব্রাউজারে পৌঁছায়, তাই এখানে শুধু পাবলিক মান থাকবে।
# গোপন কী (Supabase service_role key, DB পাসওয়ার্ড, সার্ভারের JWT secret) এখানে কখনোই রাখবেন না।

# কোন অ্যাডাপ্টার চলবে: supabase | rest
VITE_HOUSING_BACKEND=supabase

# --- supabase মোড ---
# Supabase Dashboard → Project Settings → API
# URL: https://xxxx.supabase.co ; key: "anon" / "public" লেখা key-টি (service_role নয়!)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- শুধু পরীক্ষা (dev): পুরনো-ডাটাবেস সিমুলেশন (পর্ব ২, M-ধাপ ৪) ---
# 1 দিলে adapter এমন আচরণ করে যেন SQL ১০–১২ চালানো হয়নি (প্রকল্প টেবিল, project_stats ইত্যাদি নেই) —
# ফলব্যাক পথ পরীক্ষার জন্য। প্রোডাকশন বিল্ডে কাজ করে না। সাধারণত `npm run smoke -- --legacy` নিজেই এটি দেয়।
# VITE_SIMULATE_LEGACY_DB=1

# --- rest মোড (নিজস্ব সার্ভার, ধাপ ১৩) ---
# যেমন https://api.assunnahfoundation.org  (শেষে / ছাড়া; পাথ /api/... কোডে যোগ হয়)
VITE_API_BASE_URL=

# --- শুধু scripts/migrate-photos.mjs এর জন্য (Node, লোকাল) — এগুলো `.env` ফাইলে রাখুন, `.env.local` এ নয় ---
# VITE_ প্রিফিক্স নেই, তাই ব্রাউজার বান্ডলে কখনো যাবে না। service_role key = পূর্ণ অধিকার; কারো সাথে শেয়ার নয়।
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
