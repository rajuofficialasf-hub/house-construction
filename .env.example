# এই ফাইলটি কপি করে `.env.local` নামে রাখুন এবং মান বসান। `.env.local` গিটে যাবে না।
# Vite-এ শুধু VITE_ প্রিফিক্সযুক্ত ভ্যারিয়েবল ব্রাউজারে পৌঁছায়, তাই এখানে শুধু পাবলিক মান থাকবে।
# গোপন কিছু (DB পাসওয়ার্ড, সার্ভারের সেটিং) এখানে কখনোই রাখবেন না; সেগুলো server/ এর নিজস্ব env এ।

# কোন অ্যাডাপ্টার চলবে: rest (ডিফল্ট, নিজস্ব সার্ভার) | mock (শুধু dev, ইন-মেমরি)
VITE_HOUSING_BACKEND=rest

# --- rest মোড (নিজস্ব সার্ভার) ---
# লোকালে: npm --prefix server run dev চালানো API (শেষে / ছাড়া; পাথ /api/v1/... কোডে যোগ হয়)।
# API না চললে UI "সার্ভারে সংযোগ করা যায়নি" দেখায়; সার্ভার ছাড়া দেখতে npm run dev:mock।
VITE_API_BASE_URL=http://localhost:3001
