# Proxy settings for the API locations (included by locations.conf). Rendered by
# deploy/render-nginx.sh.
# X-Forwarded-For is overwritten, never appended: with the client IP restored from Cloudflare
# (cloudflare.conf), nginx is the only hop the API trusts (TRUST_PROXY=1, NE-SEC-10), so a
# client-sent X-Forwarded-For can't reach the rate limiters.
proxy_pass http://housing_api_${HOUSING_ENV};
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_read_timeout 60s;
