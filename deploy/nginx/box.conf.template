# The housing vhost for one environment on the box, behind Cloudflare. Rendered by
# deploy/render-nginx.sh into ${HOUSING_NGINX_DIR}/housing.conf. nginx 1.20: http2 goes on the
# listen line (no "http2 on;"). TLS protocols and ciphers come from the box's http-level config.

# Upstream names are global across the box's vhosts, so each environment has its own.
upstream housing_api_${HOUSING_ENV} {
    server ${HOUSING_API_UPSTREAM};
    keepalive 8;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${HOUSING_SERVER_NAME};
    server_tokens off;

    # Cloudflare origin certificate for this hostname.
    ssl_certificate ${HOUSING_TLS_CERT};
    ssl_certificate_key ${HOUSING_TLS_KEY};

    # Authenticated Origin Pulls: only Cloudflare holds a client certificate this CA signed, so a
    # request sent straight to the box's IP fails the TLS handshake and can't skip the WAF.
    ssl_client_certificate ${HOUSING_ORIGIN_PULL_CA};
    ssl_verify_client on;

    include ${HOUSING_NGINX_DIR}/cloudflare.conf;

    access_log /var/log/nginx/housing-${HOUSING_ENV}.access.log;
    error_log /var/log/nginx/housing-${HOUSING_ENV}.error.log;

    include ${HOUSING_NGINX_DIR}/locations.conf;
}
