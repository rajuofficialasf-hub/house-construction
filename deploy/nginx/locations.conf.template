# The shared part of every housing vhost: the static UI and the API proxy. Rendered by
# deploy/render-nginx.sh. nginx 1.20 syntax only (the box runs 1.20.1).
# A location that sets its own add_header drops the server-level ones, so each UI location
# includes ui-headers.conf itself.

root ${HOUSING_WEB_ROOT};
index index.html;

# Small bodies by default; only the bulk import and the photo upload get more. The API's own
# limits (100 KB JSON, 10 MB bulk, 5 MB photo) stay the real check.
client_max_body_size 1m;

location /api/ {
    include ${HOUSING_NGINX_DIR}/api-proxy.conf;
}

location = /api/v1/housing/bulk {
    client_max_body_size 11m;
    include ${HOUSING_NGINX_DIR}/api-proxy.conf;
}

location ~ ^/api/v1/housing/[^/]+/photo$ {
    client_max_body_size 11m;
    include ${HOUSING_NGINX_DIR}/api-proxy.conf;
}

# Vite's hashed build files never change under the same name.
location /assets/ {
    include ${HOUSING_NGINX_DIR}/ui-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
}

# The SPA shell: always revalidated, so a deploy shows up at once.
location = /index.html {
    include ${HOUSING_NGINX_DIR}/ui-headers.conf;
    add_header Cache-Control "no-cache" always;
}

# Any other path is a client-side route (React Router) unless a file exists.
location / {
    include ${HOUSING_NGINX_DIR}/ui-headers.conf;
    try_files $uri /index.html;
}
