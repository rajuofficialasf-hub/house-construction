{
  "pages": [
    {
      "id": "p1", "name": "1 · Before (Supabase)", "w": 1200, "h": 520,
      "title": { "title": "Architecture before · Supabase", "sub": "The browser talks straight to Supabase · from main@87c7241 src/backend/supabase/ and supabase/sql/ · {{DATE}}" },
      "body": [
        { "type": "container", "id": "browser", "title": "Browser", "kind": "app", "x": 40, "y": 110, "w": 320, "h": 330, "children": [
          { "type": "box", "id": "ui", "kind": "app", "x": 30, "y": 60, "w": 260, "h": 90,
            "label": { "title": "React UI", "lines": ["public site + admin panel"] } },
          { "type": "box", "id": "adapter", "kind": "appfill", "x": 30, "y": 200, "w": 260, "h": 90,
            "label": { "title": "Supabase adapter", "lines": ["supabase-js client", "src/backend/supabase/"] } }
        ]},
        { "type": "container", "id": "supa", "title": "Supabase (hosted service)", "kind": "ext", "x": 520, "y": 110, "w": 540, "h": 330, "children": [
          { "type": "box", "id": "auth", "kind": "ext", "x": 30, "y": 50, "w": 220, "h": 70,
            "label": { "title": "Supabase Auth", "lines": ["email + password login"] } },
          { "type": "box", "id": "rest", "kind": "ext", "x": 30, "y": 140, "w": 220, "h": 70,
            "label": { "title": "Data API + RPC", "lines": ["tables and SQL functions"] } },
          { "type": "box", "id": "bucket", "kind": "ext", "x": 30, "y": 230, "w": 220, "h": 70,
            "label": { "title": "Storage bucket", "lines": ["housing-photos, public read"] } },
          { "type": "cyl", "id": "pg", "x": 310, "y": 110, "w": 200, "h": 130,
            "label": { "title": "PostgreSQL", "lines": ["rules = RLS policies", "+ triggers"] } }
        ]},
        { "type": "edge", "id": "e1", "src": "ui", "dst": "adapter", "kind": "flow" },
        { "type": "edge", "id": "e2", "src": "adapter", "dst": "auth", "kind": "flow", "exit": [1, 0.5], "entry": [0, 0.5] },
        { "type": "edge", "id": "e3", "src": "adapter", "dst": "rest", "kind": "flow", "exit": [1, 0.5], "entry": [0, 0.5] },
        { "type": "edge", "id": "e4", "src": "adapter", "dst": "bucket", "kind": "flow", "exit": [1, 0.5], "entry": [0, 0.5] },
        { "type": "edge", "id": "e5", "src": "rest", "dst": "pg", "kind": "flow" }
      ]
    },
    {
      "id": "p2", "name": "2 · After (own stack)", "w": 1200, "h": 520,
      "title": { "title": "Architecture after · own stack", "sub": "The browser talks only to our API · from src/backend/rest/, server/src/, server/db/migrations/ and compose.yaml · {{DATE}}" },
      "body": [
        { "type": "container", "id": "browser", "title": "Browser", "kind": "app", "x": 40, "y": 110, "w": 300, "h": 330, "children": [
          { "type": "box", "id": "ui", "kind": "app", "x": 30, "y": 60, "w": 240, "h": 90,
            "label": { "title": "React UI", "lines": ["public site + admin panel"] } },
          { "type": "box", "id": "adapter", "kind": "appfill", "x": 30, "y": 200, "w": 240, "h": 90,
            "label": { "title": "REST adapter", "lines": ["src/backend/rest/"] } }
        ]},
        { "type": "container", "id": "server", "title": "Our server (Express 5 · server/)", "kind": "app", "x": 420, "y": 110, "w": 340, "h": 330, "children": [
          { "type": "box", "id": "authmod", "kind": "serverlayer", "x": 30, "y": 50, "w": 280, "h": 70,
            "label": { "title": "Auth + roles", "lines": ["admin table, cookie sessions"] } },
          { "type": "box", "id": "routes", "kind": "serverlayer", "x": 30, "y": 140, "w": 280, "h": 70,
            "label": { "title": "API routes /api/v1", "lines": ["projects, records, photos, users"] } },
          { "type": "box", "id": "storage", "kind": "serverlayer", "x": 30, "y": 230, "w": 280, "h": 70,
            "label": { "title": "Storage adapter", "lines": ["StorageDriver, picked by STORAGE_DRIVER"] } }
        ]},
        { "type": "cyl", "id": "pg", "x": 840, "y": 140, "w": 220, "h": 120,
          "label": { "title": "PostgreSQL 17", "lines": ["dbmate migrations"] } },
        { "type": "box", "id": "s3", "kind": "data", "x": 840, "y": 290, "w": 220, "h": 80,
          "label": { "title": "Private S3 bucket", "lines": ["photos now · locally SeaweedFS"] } },
        { "type": "box", "id": "nas", "kind": "ext", "x": 840, "y": 400, "w": 220, "h": 70,
          "label": { "title": "NAS folder", "lines": ["next step · a config change"] } },
        { "type": "edge", "id": "e1", "src": "ui", "dst": "adapter", "kind": "flow" },
        { "type": "edge", "id": "e2", "src": "adapter", "dst": "routes", "kind": "flow", "label": "HTTP + cookie", "exit": [1, 0.5], "entry": [0, 0.5] },
        { "type": "edge", "id": "e3", "src": "routes", "dst": "pg", "kind": "flow", "exit": [1, 0.5], "entry": [0, 0.5] },
        { "type": "edge", "id": "e4", "src": "storage", "dst": "s3", "kind": "flow", "label": "s3", "exit": [1, 0.5], "entry": [0, 0.5] },
        { "type": "edge", "id": "e5", "src": "storage", "dst": "nas", "kind": "dashed", "label": "nas", "exit": [1, 0.8], "entry": [0, 0.5] }
      ]
    }
  ]
}
