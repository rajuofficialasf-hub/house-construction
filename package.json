{
  "name": "asf-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_HOUSING_BACKEND=mock vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "migrate-photos": "tsx scripts/migrate-photos.mjs",
    "security-check": "node scripts/security-check.mjs",
    "build-map": "tsx scripts/build-map.mjs",
    "i18n-check": "node scripts/i18n-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:mock": "playwright test --project=mock --project=public-mock",
    "test:e2e:live": "node scripts/e2e-live.mjs",
    "test:all": "npm run i18n-check && npm run test && npm run check:prod-bundle && npm run test:e2e:mock",
    "check:prod-bundle": "node scripts/check-prod-bundle.mjs",
    "test:contract:supabase-local": "node scripts/contract-supabase-local.mjs",
    "test:contract:rest": "node scripts/contract-rest.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "d3-geo": "^3.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "topojson-client": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "mapshaper": "^0.7.70",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
