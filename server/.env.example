# Copy to server/.env for local development. The values below match compose.yaml's local
# defaults; real servers get their own values from an env file outside the repo.
NODE_ENV=development
# Interface the API listens on. Loopback (the default) on servers, so only nginx reaches it.
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Number of proxies whose X-Forwarded-For the API trusts. 0 locally. 1 on the box: nginx restores
# the client IP from Cloudflare and overwrites X-Forwarded-For, so it is the only hop the API sees.
TRUST_PROXY=0
# Browser origins allowed to call the API with the session cookie, comma-separated.
# Production lists the site's own origin, e.g. https://housing.example.org.
ALLOWED_ORIGINS=http://localhost:5173
# Other apps' origins that may read the public housing endpoints from the browser, without the
# cookie and never writing. Comma-separated; empty means none. Must not repeat an ALLOWED_ORIGINS entry.
PUBLIC_READ_ORIGINS=
# Public reads allowed per IP per minute. Unset means the built-in 300; only the Playwright
# admin-rest server raises it, because a whole test run comes from one IP.
# READ_RATE_LIMIT=
# The session cookie is Secure unless this is false. Only plain-http local development sets false.
COOKIE_SECURE=false
# The API's public base URL. Stored photo URLs are built from it, so production sets its real
# https address before the first upload.
PUBLIC_API_URL=http://localhost:3001

# Where photos are stored (NS-34): s3 (the first production store) or nas (a folder; the next step).
# Locally, s3 is compose.yaml's SeaweedFS (`docker compose up -d db s3`); the keys below are its
# local-only defaults. A real deployment gets AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY (or the
# host's IAM role) from outside the repo, and needs neither S3_ENDPOINT nor S3_FORCE_PATH_STYLE on AWS.
STORAGE_DRIVER=s3
S3_BUCKET=housing-photos
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:8333
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=housing_s3_local
AWS_SECRET_ACCESS_KEY=housing_s3_local_secret
# The NAS driver instead: files under a folder.
# STORAGE_DRIVER=nas
# STORAGE_ROOT=./.storage/dev

# Runtime role: reads and writes data, can't change the schema.
DATABASE_URL=postgres://housing_app:housing_app_local@127.0.0.1:5432/housing?sslmode=disable
# Migration role: owns the schema. Used only by db:migrate and db:seed.
DATABASE_MIGRATION_URL=postgres://housing_owner:housing_owner_local@127.0.0.1:5432/housing?sslmode=disable

# Server tests. Must point at a local database that holds no real data.
TEST_DATABASE_URL=postgres://housing_app:housing_app_local@127.0.0.1:5432/housing_test?sslmode=disable
TEST_DATABASE_MIGRATION_URL=postgres://housing_owner:housing_owner_local@127.0.0.1:5432/housing_test?sslmode=disable

# The S3 storage tests, against the local SeaweedFS's test bucket (they skip when these are unset).
# Vitest doesn't read this file: export them, with the AWS keys above, before `npm --prefix server test`.
# TEST_S3_BUCKET=housing-photos-test
# TEST_S3_REGION=us-east-1
# TEST_S3_ENDPOINT=http://127.0.0.1:8333
# TEST_S3_FORCE_PATH_STYLE=true
