# Copy to server/.env for local development. The values below match compose.yaml's local
# defaults; real servers get their own values from an env file outside the repo.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Number of proxies in front of the API (nginx + Cloudflare in production). 0 locally.
TRUST_PROXY=0
# Browser origins allowed to call the API with the session cookie, comma-separated.
# Production lists the site's own origin, e.g. https://housing.example.org.
ALLOWED_ORIGINS=http://localhost:5173
# Other apps' origins that may read the public housing endpoints from the browser, without the
# cookie and never writing. Comma-separated; empty means none. Must not repeat an ALLOWED_ORIGINS entry.
PUBLIC_READ_ORIGINS=
# The session cookie is Secure unless this is false. Only plain-http local development sets false.
COOKIE_SECURE=false

# Runtime role: reads and writes data, can't change the schema.
DATABASE_URL=postgres://housing_app:housing_app_local@127.0.0.1:5432/housing?sslmode=disable
# Migration role: owns the schema. Used only by db:migrate and db:seed.
DATABASE_MIGRATION_URL=postgres://housing_owner:housing_owner_local@127.0.0.1:5432/housing?sslmode=disable

# Server tests. Must point at a local database that holds no real data.
TEST_DATABASE_URL=postgres://housing_app:housing_app_local@127.0.0.1:5432/housing_test?sslmode=disable
TEST_DATABASE_MIGRATION_URL=postgres://housing_owner:housing_owner_local@127.0.0.1:5432/housing_test?sslmode=disable
