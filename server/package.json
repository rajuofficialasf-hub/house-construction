{
  "name": "housing-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "dbmate --env DATABASE_MIGRATION_URL --migrations-dir db/migrations --no-dump-schema --wait up",
    "db:status": "dbmate --env DATABASE_MIGRATION_URL --migrations-dir db/migrations --no-dump-schema status",
    "db:rollback": "dbmate --env DATABASE_MIGRATION_URL --migrations-dir db/migrations --no-dump-schema rollback",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db-seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@node-rs/bcrypt": "^1.10.9",
    "cors": "^2.8.6",
    "dbmate": "^2.36.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
